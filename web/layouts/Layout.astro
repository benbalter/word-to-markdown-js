---
// Shared shell for every page. Unifies the head, brand header, and footer
// that were previously duplicated (and inconsistent) between the converter
// page and the legal pages.
//
// Invariants enforced here (the e2e suite depends on them):
//   - The brand/site title is NOT an <h1>, so each page owns its single <h1>.
//   - `title` is per-page and rendered verbatim into <title>.
//   - Nav hrefs are absolute so they resolve correctly from inner pages too.
// Dark-mode theming applies to every page (body, links, code, borders).
import '../../src/dark-mode.css';

interface Props {
  title: string;
  description?: string;
}

// `.astro` pages pass props directly; Markdown pages using `layout:` pass
// them nested under `frontmatter`. Support both shapes.
const {
  title,
  description = 'Convert Word or Google documents to Markdown online',
} = Astro.props.frontmatter ?? Astro.props;

// Canonical/OG URL derived from `site` + the current path.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Word to Markdown Converter" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="container text-center mt-2">
      <p class="display-4 mb-2">
        <a href="/" class="text-decoration-none text-body"
          >Word to Markdown Converter</a
        >
      </p>

      <slot />

      <nav class="nav justify-content-center mt-2">
        <a
          href="https://github.com/benbalter/word-to-markdown-js/blob/master/CONTRIBUTING.md"
          class="nav-link">Feedback</a
        >
        <a
          href="https://github.com/benbalter/word-to-markdown-js"
          class="nav-link">Source</a
        >
        <a href="https://www.patreon.com/benbalter" class="nav-link">Donate</a>
        <a href="/terms/" class="nav-link">Terms</a>
        <a href="/privacy/" class="nav-link">Privacy</a>
        <a href="https://ben.balter.com" class="nav-link">@benbalter</a>
      </nav>
    </div>
  </body>
</html>
