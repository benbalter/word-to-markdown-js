---
// Shared shell for every page. Unifies the head, brand header, and footer.
//
// Invariants the e2e suite depends on:
//   - The brand/site title is NOT an <h1>, so each page owns its single <h1>.
//   - `title` is per-page and rendered verbatim into <title>.
//   - Nav hrefs are absolute so they resolve correctly from inner pages too,
//     and each footer href appears exactly once (Playwright locators are strict).
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}

// `.astro` pages pass props directly; Markdown pages using `layout:` pass
// them nested under `frontmatter`. Support both shapes.
const {
  title,
  description = 'Convert Word or Google documents to Markdown online',
  image = '/og.png',
  structuredData,
} = Astro.props.frontmatter ?? Astro.props;

// Canonical / OG / social-image URLs derived from `site` + the current path.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const footerLinks = [
  {
    href: 'https://github.com/benbalter/word-to-markdown-js/blob/master/CONTRIBUTING.md',
    label: 'Feedback',
  },
  { href: 'https://github.com/benbalter/word-to-markdown-js', label: 'Source' },
  { href: 'https://www.patreon.com/benbalter', label: 'Donate' },
  { href: '/terms/', label: 'Terms' },
  { href: '/privacy/', label: 'Privacy' },
  { href: 'https://ben.balter.com', label: '@benbalter' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Word to Markdown Converter" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f6f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1120" media="(prefers-color-scheme: dark)" />
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
    <Font cssVariable="--font-fraunces" />
    <Font cssVariable="--font-hanken" />
    <Font cssVariable="--font-jetbrains" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="mx-auto w-full max-w-5xl px-6 pt-7 pb-2">
      <a
        href="/"
        class="group inline-flex items-center gap-2.5 no-underline"
        aria-label="Word to Markdown — home"
      >
        <span
          class="rounded-md border border-chartreuse/50 bg-chartreuse/10 px-1.5 py-0.5 font-mono text-[0.68rem] font-bold tracking-tight text-chartreuse-deep transition-colors group-hover:border-chartreuse dark:text-chartreuse"
          >w2m</span
        >
        <span
          class="font-display text-lg font-medium tracking-tight text-navy dark:text-[#eef0f6]"
          >Word to Markdown</span
        >
      </a>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-6">
      <slot />
    </main>

    <footer class="mx-auto mt-16 w-full max-w-5xl px-6 pb-10">
      <div class="rule mb-5"></div>
      <nav
        class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm"
      >
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              class="font-medium text-navy-soft underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:text-navy hover:decoration-chartreuse dark:text-mist dark:hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <p
        class="mt-5 text-center font-mono text-[0.7rem] tracking-wide text-navy-soft/70 dark:text-mist/70"
      >
        Converted in your browser · nothing is uploaded
      </p>
    </footer>
  </body>
</html>
