---
import Layout from '../layouts/Layout.astro';
// The promo banner is home-only, so its CSS stays here. Dark-mode theming is
// site-wide and lives in the Layout. (Astro needs CSS imported at the
// component layer to emit it.) The browser logic is imported via the <script>
// below, bundled through Astro's Vite pipeline.
import '../../src/promo.css';
---

<Layout title="Word to Markdown">
  <h1>Word to Markdown</h1>
  <div id="input">
    <div class="row mt-3">
      <div class="col">
        <h3>Step 1</h3>
        <h4>Upload a <code>.docx</code> file</h4>
        <p class="text-muted">Drag-and-drop the file below to upload.</p>
        <p class="text-muted">
          Google doc? File → Download as → <code>.docx</code>.
        </p>
      </div>
      <div class="col">
        <h3>Step 2</h3>
        <h4>Get back crisp, clean Markdown</h4>
        <pre class="bg-light border p-2 mt-3 text-start"><code># H1

Paragraph

## H2

Paragraph

### H3

Paragraph
        </code></pre>
      </div>

      <div class="col">
        <h3>Step 3</h3>
        <h4>???</h4>
      </div>
    </div>
    <div class="row">
      <form>
        <div class="form-group">
          <input type="file" id="file" class="form-control-file p-2 border" />
          <button type="button" class="btn btn-primary btn-lg"> Submit </button>
        </div>
      </form>
    </div>
  </div>
  <div id="results" class="d-none">
    <h2>Results of converting <span id="filename"></span></h2>

    <div class="moar">
      <button
        id="copy-button"
        type="button"
        class="btn btn-outline-primary"
        data-clipboard-target="#output"
      >
        Copy markdown to clipboard
      </button>
    </div>

    <div class="row mt-3">
      <div class="col-6">
        <h3>Markdown</h3>
        <pre
          class="bg-light border text-start p-2 pre-scrollable"
        ><code id="output" class="force-select-all"></code></pre>
      </div>
      <div class="col-6">
        <h3>Rendered</h3>
        <div
          id="rendered"
          class="bg-light border text-start pre-scrollable py-1 px-2"
        >
        </div>
      </div>
    </div>
  </div>
  <a
    class="promo"
    href="https://open-and-async.com/?utm_source=word2md&utm_medium=referral"
  >
    <svg
      class="promo-graph"
      viewBox="0 0 560 150"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      role="presentation"
      aria-hidden="true"
    >
      <!-- chartreuse trunk -->
      <path
        d="M-10 88 C 110 88 165 78 265 80 S 455 98 580 84"
        stroke="#d0d820"
        stroke-width="2.2"></path>
      <circle cx="60" cy="85" r="5" fill="#d0d820"></circle>
      <circle cx="175" cy="79" r="5" fill="#d0d820"></circle>
      <circle
        cx="330"
        cy="84"
        r="7"
        fill="none"
        stroke="#d0d820"
        stroke-width="2"></circle>
      <circle cx="470" cy="91" r="5" fill="#d0d820"></circle>
      <!-- pink branch: diverges up -->
      <path
        d="M165 80 C 225 44 280 26 350 32 S 455 58 510 84"
        stroke="#e068a0"
        stroke-width="1.8"></path>
      <circle cx="350" cy="32" r="5" fill="#e068a0"></circle>
      <circle cx="440" cy="52" r="4" fill="#e068a0"></circle>
      <!-- coral branch: diverges down -->
      <path
        d="M265 80 C 325 118 365 136 455 134 S 600 122 630 134"
        stroke="#e89068"
        stroke-width="1.8"></path>
      <circle cx="455" cy="134" r="5" fill="#e89068"></circle>
    </svg>
    <img
      class="promo-cover"
      src="/open-and-async-cover.png"
      width="92"
      height="127"
      alt="Open and Async book cover"
    />
    <span class="promo-text">
      <span class="promo-label">Sponsored by me</span>
      <span class="promo-body">
        I built this free tool — and I wrote the book on working in the open:
        <strong>Open &amp; Async</strong>, the GitHub-tested playbook for remote
        and distributed teams.
      </span>
      <span class="promo-cta">Get notified &rarr;</span>
    </span>
  </a>
</Layout>

<script>
  import '../../src/index.ts';
</script>
