---
// Hero: eyebrow, wordmark <h1>, tagline, and the .docx → .md visual flow.
// Owns the page's single <h1> (Layout deliberately keeps the brand out of one).
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
const eyebrowParts = t.eyebrow.split(' · ');
---

<section class="mx-auto max-w-3xl pt-14 pb-2 text-center sm:pt-20">
  {/* Each " · " segment stays on one line, so a narrow screen breaks between
       claims rather than orphaning a word ("BROWSER") on a line of its own. */}
  <p
    class="reveal font-mono text-[0.72rem] font-medium tracking-[0.22em] text-balance rtl:font-sans rtl:tracking-normal text-chartreuse-deep uppercase dark:text-chartreuse [--reveal-delay:.02s]"
  >
    {
      eyebrowParts.map((part, i) => (
        <>
          {i > 0 && ' '}
          <span class="whitespace-nowrap">
            {i < eyebrowParts.length - 1 ? `${part}\u00a0·` : part}
          </span>
        </>
      ))
    }
  </p>

  <h1
    class="reveal-rise mt-5 text-balance text-5xl leading-[0.98] font-semibold tracking-tight text-navy sm:text-7xl dark:text-snow [--reveal-delay:.08s]"
  >
    <span class="font-display italic">Word</span>{' '}
    <span class="font-sans font-normal text-navy-soft dark:text-mist">to</span>{
      ' '
    }
    <span class="font-mono font-medium tracking-tighter">Markdown</span>
  </h1>

  <p
    class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-navy-soft sm:text-xl dark:text-mist [--reveal-delay:.16s]"
    set:html={t.tagline.replace(
      '.docx',
      '<code class="rounded bg-navy/5 px-1.5 py-0.5 font-mono text-[0.85em] text-navy dark:bg-white/10 dark:text-snow">.docx</code>'
    )}
  >
  </p>

  {/* Visual .docx → .md flow: communicates the core function before reading. */}
  <div
    class="reveal mt-7 flex items-center justify-center gap-3 text-navy-soft dark:text-mist [--reveal-delay:.2s]"
    role="img"
    aria-label={`${t.flowFromAlt} → ${t.flowToAlt}`}
  >
    <span
      class="inline-flex items-center gap-2 rounded-lg border border-rule-light bg-paper-card/70 px-3 py-2 dark:border-rule-dark dark:bg-ink-card/60"
      title={t.flowFromAlt}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
        <path d="M14 2v5h5" />
      </svg>
      <span class="font-mono text-xs font-medium tracking-tight" dir="ltr">.docx</span>
    </span>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-chartreuse-deep rtl:-scale-x-100 dark:text-chartreuse"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>

    <span
      class="inline-flex items-center gap-2 rounded-lg border border-chartreuse/40 bg-chartreuse/10 px-3 py-2 text-chartreuse-deep dark:text-chartreuse"
      title={t.flowToAlt}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
        <path d="M14 2v5h5" />
        <path d="M8 13h2v4" />
        <path d="M14 13v4l2-2 2 2v-4" />
      </svg>
      <span class="font-mono text-xs font-medium tracking-tight" dir="ltr">.md</span>
    </span>
  </div>

  {/* Lineage, stated plainly: "Converting docs since 2014", not "Trusted since 2014",
       which asks for trust the line can't evidence. The tool has existed
       since 2014 (the original word-to-markdown / word2md.herokuapp.com),
       predating the word2md.com domain (2019). A history icon, not a
       shield: a shield-check reads as a security seal, which the site
       can't claim. */}
  <p
    class="reveal mt-6 inline-flex items-center gap-1.5 font-mono text-[0.7rem] font-medium tracking-wide rtl:font-sans rtl:tracking-normal text-navy-soft dark:text-mist [--reveal-delay:.28s]"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-chartreuse-deep dark:text-chartreuse"
      aria-hidden="true"
    >
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
      <path d="M3 3v5h5" />
      <path d="M12 7v5l4 2" />
    </svg>
    {t.trustBadge}
  </p>
</section>
