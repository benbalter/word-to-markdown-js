---
// Hero: eyebrow, wordmark <h1>, tagline, and the .docx → .md visual flow.
// Owns the page's single <h1> (Layout deliberately keeps the brand out of one).
import { asLocale, useTranslations } from '../../i18n';

interface Props {
  /** Locale for this page; pages set it statically from their route. */
  lang: string;
}

const t = useTranslations(asLocale(Astro.props.lang));
---

<section class="mx-auto max-w-3xl pt-14 pb-2 text-center sm:pt-20">
  <p
    class="reveal font-mono text-[0.72rem] font-medium tracking-[0.22em] text-chartreuse-deep uppercase dark:text-chartreuse"
    style="animation-delay:.02s"
  >
    {t.eyebrow}
  </p>

  <h1
    class="reveal mt-5 text-balance text-5xl leading-[0.98] font-semibold tracking-tight text-navy sm:text-7xl dark:text-[#f1f2f7]"
    style="animation-delay:.08s"
  >
    <span class="font-display italic">Word</span>{' '}
    <span class="font-sans font-light text-navy-soft dark:text-mist">to</span>{
      ' '
    }
    <span class="font-mono font-medium tracking-tighter">Markdown</span>
  </h1>

  <p
    class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-navy-soft sm:text-xl dark:text-mist"
    style="animation-delay:.16s"
    set:html={t.tagline.replace(
      '.docx',
      '<code class="rounded bg-navy/5 px-1.5 py-0.5 font-mono text-[0.85em] text-navy dark:bg-white/10 dark:text-[#eef0f6]">.docx</code>'
    )}
  >
  </p>

  <!-- Visual .docx → .md flow: communicates the core function before reading. -->
  <div
    class="reveal mt-7 flex items-center justify-center gap-3 text-navy-soft dark:text-mist"
    style="animation-delay:.2s"
    role="img"
    aria-label={`${t.flowFromAlt} → ${t.flowToAlt}`}
  >
    <span
      class="inline-flex items-center gap-2 rounded-lg border border-rule-light bg-paper-card/70 px-3 py-2 dark:border-rule-dark dark:bg-ink-card/60"
      title={t.flowFromAlt}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
        <path d="M14 2v5h5" />
      </svg>
      <span class="font-mono text-xs font-medium tracking-tight">.docx</span>
    </span>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-chartreuse-deep dark:text-chartreuse"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>

    <span
      class="inline-flex items-center gap-2 rounded-lg border border-chartreuse/40 bg-chartreuse/10 px-3 py-2 text-chartreuse-deep dark:text-chartreuse"
      title={t.flowToAlt}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
        <path d="M14 2v5h5" />
        <path d="M8 13h2v4" />
        <path d="M14 13v4l2-2 2 2v-4" />
      </svg>
      <span class="font-mono text-xs font-medium tracking-tight">.md</span>
    </span>
  </div>
</section>
