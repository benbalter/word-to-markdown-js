---
// Converter: the dropzone (input) and the post-conversion results panels.
// The element ids and data-* attributes here are the contract with the browser
// logic in src/index.ts and web/scripts/converter/ — keep them in sync with
// those modules.
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);
---

<section
  class="reveal mx-auto mt-10 max-w-2xl [--reveal-delay:.24s]"
  aria-label={t.convertSectionAria}
>
  {/* Polite live region: a successful conversion announces here for screen
       readers (the results reveal is otherwise silent). */}
  <div id="sr-status" role="status" class="sr-only"></div>

  <div
    id="input"
    data-error-generic={t.errorGeneric}
    data-doc-file-error={t.docFileError}
    data-file-too-large={t.fileTooLargeError}
    data-invalid-file-error={t.invalidFileError}
    data-not-word-file-error={t.notWordFileError}
    data-protected-file-error={t.protectedFileError}
    data-copy-failed={t.copyFailed}
    data-batch-progress={t.batchProgress}
    data-batch-has-warnings={t.batchHasWarnings}
    data-batch-some-failed={t.batchSomeFailed}
    data-too-many-files={t.tooManyFiles}
    data-conversion-announcement={t.conversionAnnouncement}
    data-converting={t.convertingStatus}
    data-copied={t.copiedButton}
    data-downloaded={t.downloadedButton}
    data-downloaded-zip={t.downloadedZipButton}
    data-dismiss={t.dismiss}
    data-warning-encrypted={t.warnings.encrypted}
    data-warning-sensitivity={t.warnings.sensitivity}
    data-warning-confidentiality={t.warnings.confidentiality}
    data-warning-protected={t.warnings.protected}
    data-warning-content-loss={t.warnings.contentLoss}
    data-warning-content-loss-items={t.warnings.contentLossItems}
    data-warning-kind-equations={t.warnings.contentKinds.equations}
    data-warning-kind-images={t.warnings.contentKinds.images}
    data-warning-kind-symbols={t.warnings.contentKinds.symbols}
    data-warning-kind-objects={t.warnings.contentKinds.objects}
    data-warning-kind-other={t.warnings.contentKinds.other}
    data-warning-kind-comments={t.warnings.contentKinds.comments}
    data-warning-kind-headers-footers={t.warnings.contentKinds.headersFooters}
    data-warning-kind-text-boxes={t.warnings.contentKinds.textBoxes}
    data-warning-technical={t.warnings.technical}
  >
    <label
      for="file"
      id="dropzone"
      class="dropzone group flex cursor-pointer flex-col items-center rounded-2xl px-6 py-14 text-center backdrop-blur-sm"
    >
      <span
        class="dropzone-icon mb-5 inline-flex h-14 w-14 items-center justify-center rounded-full border border-chartreuse/40 bg-chartreuse/10 text-chartreuse-deep transition-transform dark:text-chartreuse"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {/* A file going in, not an upload arrow: nothing leaves the device. */}
          <path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4" />
          <path d="M14 2v4a2 2 0 0 0 2 2h4" />
          <path d="M2 15h10" />
          <path d="m9 18 3-3-3-3" />
        </svg>
      </span>
      {/* "Drop" is the wrong verb on a phone, where there's nothing to drag
           from: touch screens (a coarse primary pointer) get "Choose a .docx
           file" and lose the "or click to choose" line, which would repeat
           it. The touch title is also the file input's accessible name on
           every device: a screen reader user chooses rather than drops. */}
      <span
        class="font-display text-xl font-medium text-navy dark:text-snow"
      >
        <span class="pointer-coarse:hidden">{t.dropzoneTitle}</span>
        <span id="dropzone-title" class="hidden pointer-coarse:inline"
          >{t.dropzoneTitleTouch}</span
        >
      </span>
      <span
        class="mt-1.5 text-sm text-navy-soft pointer-coarse:hidden dark:text-mist"
      >
        {t.dropzoneBrowsePrefix}<span
          class="font-medium text-chartreuse-deep underline decoration-2 underline-offset-2 dark:text-chartreuse"
          >{t.dropzoneBrowseLink}</span
        >
      </span>
      {/* Reassurance at the moment of dropping a possibly sensitive file. It
           stays visible while converting (the dropzone does), not just in the
           hero above. Also states the browser's size limit up front. */}
      <span
        id="dropzone-note"
        class="mt-5 block max-w-xs font-mono text-[0.72rem] tracking-wide text-balance text-navy-soft sm:max-w-none rtl:font-sans rtl:tracking-normal dark:text-mist"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="me-1.5 inline-block align-[-2px] text-chartreuse-deep dark:text-chartreuse"
          aria-hidden="true"
        >
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        {t.dropzoneNote}
      </span>
      {/* Named by the short title and described by the note, rather than
           named by the whole <label>'s text run together. */}
      {/* `multiple`: several files convert one after another, listed
           together (see processBatch in src/index.ts). One file converts
           exactly as before. */}
      <input
        type="file"
        id="file"
        multiple
        aria-labelledby="dropzone-title"
        aria-describedby="dropzone-note"
        accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        class="sr-only"
      />
    </label>

    {/* "Converting 2 of 5…" while several files convert. Screen readers hear
         it from #sr-status instead, so it's hidden from them here. */}
    <p
      id="batch-progress"
      aria-hidden="true"
      class="mt-3 hidden text-center font-mono text-[0.72rem] tracking-wide rtl:font-sans rtl:tracking-normal text-navy-soft dark:text-mist"
    >
    </p>

    <p
      class="mt-4 text-center font-mono text-[0.72rem] tracking-wide rtl:font-sans rtl:tracking-normal text-navy-soft dark:text-mist"
    >
      {t.googleDocHint}
    </p>
  </div>

  {/* Results (revealed after a successful conversion) */}
  <div id="results" class="hidden scroll-mt-6">
    {/* Several files converted at once: one row per file (a button that
         shows it in the panels below, or why it failed), and one .zip of them
         all, the next action. Hidden for a single document. See
         web/scripts/converter/batch.ts. */}
    <div id="batch" class="mt-4 hidden">
      <ul
        id="batch-list"
        aria-label={t.batchListLabel}
        class="divide-y divide-rule-light overflow-hidden rounded-xl border border-rule-light bg-paper-card/70 dark:divide-rule-dark dark:border-rule-dark dark:bg-ink-card/70"
      >
      </ul>
      <div
        class="mt-3 flex flex-col items-center gap-2 sm:flex-row sm:items-center sm:gap-4"
      >
        <button
          id="download-all-button"
          type="button"
          class="btn btn-accent confirmable hidden"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="idle-icon"
            aria-hidden="true"
          >
            <path
              d="M21 8v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
            />
            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
            <rect x="9" y="12" width="2" height="2" />
            <rect x="9" y="16" width="2" height="2" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="confirm-icon"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" pathLength="1" />
          </svg>
          <span id="download-all-label">{t.downloadAllButton}</span>
        </button>
        <p
          id="batch-note"
          class="hidden max-w-prose text-center text-sm leading-relaxed text-navy-soft sm:text-start dark:text-mist"
        >
        </p>
      </div>
    </div>

    {/* Filename on its own line, actions below: side by side, a long name
         wrapped mid-word ("dropped-" / "content.docx") beside four buttons. */}
    <div
      id="result-head"
      class="mt-4 flex flex-col items-center gap-3 sm:items-start"
    >
      <h2
        id="result-heading"
        class="max-w-full text-center font-display text-lg font-medium text-navy sm:text-start dark:text-snow"
      >
        {t.convertedLabel}{' '}<bdi
          id="filename"
          class="fresh-mark font-mono text-base break-all text-chartreuse-deep dark:text-chartreuse"
        ></bdi>
      </h2>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {/* One filled accent: the next action. That's Copy, unless the
             document has images, when setImageMode() moves the accent (and
             the leading spot) to Download .zip, since the Markdown alone
             carries the images as long base64 strings. */}
        <button
          id="copy-button"
          type="button"
          class="btn btn-accent confirmable"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="idle-icon"
            aria-hidden="true"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="confirm-icon"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" pathLength="1" />
          </svg>
          <span id="copy-label">{t.copyButton}</span>
        </button>
        <button
          id="download-button"
          type="button"
          class="btn btn-secondary confirmable"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="idle-icon"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="M7 10l5 5 5-5" />
            <path d="M12 15V3" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="confirm-icon"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" pathLength="1" />
          </svg>
          <span id="download-label">{t.downloadButton}</span>
        </button>
        <button
          id="download-zip-button"
          type="button"
          class="btn btn-secondary confirmable hidden disabled:opacity-60"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="idle-icon"
            aria-hidden="true"
          >
            <path
              d="M21 8v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
            />
            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
            <rect x="9" y="12" width="2" height="2" />
            <rect x="9" y="16" width="2" height="2" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="confirm-icon"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" pathLength="1" />
          </svg>
          <span id="download-zip-label">{t.downloadZipButton}</span>
        </button>
        <button
          id="convert-another"
          type="button"
          class="btn btn-secondary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 12a9 9 0 0 1 9-9 9 9 0 0 1 6.7 3H21" />
            <path d="M21 3v3h-3" />
            <path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-6.7-3H3" />
            <path d="M3 21v-3h3" />
          </svg>
          {t.convertAnother}
        </button>
      </div>
      <p
        id="images-note"
        class="hidden max-w-prose text-center text-sm leading-relaxed text-navy-soft sm:text-start dark:text-mist"
      >
        {t.imagesNote}
      </p>
    </div>

    <div id="result-panels" class="mt-4 grid gap-4 lg:grid-cols-2">
      {/* The Markdown panel lights up like an added diff hunk when a document
           converts, and again on Copy (the text that just hit the clipboard):
           see .md-panel in global.css and replayClass() in
           web/scripts/converter/dom.ts. */}
      <div
        class="md-panel relative overflow-hidden rounded-xl border border-rule-light bg-paper-card dark:border-rule-dark dark:bg-ink-card"
      >
        <div
          class="flex items-center gap-2 border-b border-rule-light px-4 py-2 dark:border-rule-dark"
        >
          <span class="md-dot h-2.5 w-2.5 rounded-full bg-chartreuse"></span>
          <span
            class="font-mono text-xs font-medium tracking-wide rtl:font-sans rtl:tracking-normal text-navy-soft uppercase dark:text-mist"
            >{t.panelMarkdown}</span
          >
        </div>
        <pre
          class="max-h-[28rem] overflow-auto whitespace-pre-wrap [overflow-wrap:anywhere] px-4 py-3 text-start" dir="ltr" tabindex="0" data-select-all><code id="output" class="font-mono text-[0.82rem] leading-relaxed text-navy dark:text-snow"></code></pre>
      </div>

      <div
        class="overflow-hidden rounded-xl border border-rule-light bg-paper-card dark:border-rule-dark dark:bg-ink-card"
      >
        <div
          class="flex items-center gap-2 border-b border-rule-light px-4 py-2 dark:border-rule-dark"
        >
          <span class="h-2.5 w-2.5 rounded-full bg-navy-soft dark:bg-mist"></span>
          <span
            class="font-mono text-xs font-medium tracking-wide rtl:font-sans rtl:tracking-normal text-navy-soft uppercase dark:text-mist"
            >{t.panelPreview}</span
          >
        </div>
        <div
          id="rendered"
          dir="auto"
          tabindex="0"
          data-select-all
          class="prose prose-sm dark:prose-invert max-h-[28rem] max-w-none overflow-auto px-4 py-3 text-start"
        >
        </div>
      </div>
    </div>

    {/* Contextual Open & Async pitch after a successful conversion. It is the
         only ask on the results screen (src/index.ts hides the standalone
         Promo card on success), but it stays quiet: a hairline row with a text
         link after the output, so the filled accent belongs to Copy, the next
         conversion action. utm_campaign=results tells this placement apart
         from the card. */}
    <aside
      class="mt-6 flex flex-col gap-1.5 rounded-xl border border-rule-light px-4 py-3 text-start text-sm sm:flex-row sm:items-center sm:justify-between sm:gap-4 dark:border-rule-dark"
    >
      <p class="leading-relaxed text-navy-soft dark:text-mist">
        {t.promo.resultsLead}
      </p>
      <a
        href="https://open-and-async.com/?utm_source=word2md&utm_medium=referral&utm_campaign=results"
        class="inline-flex shrink-0 items-center gap-1.5 font-medium whitespace-nowrap text-chartreuse-deep underline decoration-chartreuse/50 decoration-2 underline-offset-4 transition-colors hover:decoration-chartreuse dark:text-chartreuse"
      >
        {t.promo.resultsCta}
        <span aria-hidden="true" class="rtl:-scale-x-100">&rarr;</span>
      </a>
    </aside>
  </div>
</section>
