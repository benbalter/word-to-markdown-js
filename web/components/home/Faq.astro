---
// FAQ accordion. The same t.faqs array also feeds the FAQPage JSON-LD emitted
// from Home.astro, so visible questions and structured data stay in lockstep.
import { asLocale, useTranslations } from '../../i18n';

interface Props {
  /** Locale for this page; pages set it statically from their route. */
  lang: string;
}

const t = useTranslations(asLocale(Astro.props.lang));
---

<section class="mx-auto mt-20 max-w-3xl">
  <h2
    class="text-center font-display text-2xl font-semibold tracking-tight text-navy sm:text-3xl dark:text-[#f1f2f7]"
  >
    {t.faqHeading}
  </h2>
  <div
    class="mt-8 divide-y divide-rule-light overflow-hidden rounded-xl border border-rule-light dark:divide-rule-dark dark:border-rule-dark"
  >
    {
      t.faqs.map((faq) => (
        <details class="group bg-paper-card/60 dark:bg-ink-card/50">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-base font-medium text-navy [&::-webkit-details-marker]:hidden dark:text-[#f1f2f7]">
            {faq.q}
            <svg
              class="h-4 w-4 shrink-0 text-chartreuse-deep transition-transform group-open:rotate-180 dark:text-chartreuse"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-navy-soft dark:text-mist">
            {faq.a}
          </p>
        </details>
      ))
    }
  </div>
</section>
