---
// A callout card: a heading and a line of copy beside one outbound link.
// Home.astro uses it for the command-line tool and for md2word.app, the
// converter that goes the other way. Each link's href must differ from every
// footer href (a README anchor, a UTM query) so the e2e strict locators stay
// single-match.
interface Props {
  heading: string;
  body: string;
  cta: string;
  href: string;
}

const { heading, body, cta, href } = Astro.props;
---

<section class="mx-auto mt-16 max-w-2xl">
  <div
    class="flex flex-col items-start gap-4 rounded-xl border border-rule-light bg-paper-card/60 px-6 py-6 sm:flex-row sm:items-center sm:justify-between dark:border-rule-dark dark:bg-ink-card/50"
  >
    <div>
      <h2
        class="font-display text-lg font-medium text-navy dark:text-snow"
      >
        {heading}
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-navy-soft dark:text-mist">
        {body}
      </p>
    </div>
    <a
      href={href}
      class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-navy/15 bg-paper-card px-3.5 py-2 text-sm font-medium text-navy transition-colors hover:border-chartreuse hover:bg-chartreuse/10 dark:border-white/15 dark:bg-ink-card dark:text-snow dark:hover:border-chartreuse"
    >
      {cta}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </svg>
    </a>
  </div>
</section>
