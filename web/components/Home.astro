---
import Layout from '../layouts/Layout.astro';
import { asLocale, localeMeta, useTranslations } from '../i18n';
// The promo banner is home-only, so its CSS stays here. Dark-mode theming and
// the Tailwind layer live in the Layout's global.css. The browser logic is
// imported via the <script> at the end, bundled through Astro's Vite pipeline.
import '../../src/promo.css';

interface Props {
  /** Locale for this page; pages set it statically from their route. */
  lang: string;
}

const locale = asLocale(Astro.props.lang);
const meta = localeMeta[locale];
const t = useTranslations(locale);

// Structured data (schema.org) for rich results: the app entity + the FAQ.
// `inLanguage` and the human-readable copy follow the active locale.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Word to Markdown Converter',
      url: 'https://word2md.com',
      description: t.schemaDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: meta.htmlLang,
      image: 'https://word2md.com/og.png',
      isAccessibleForFree: true,
      featureList: t.schemaFeatureList,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: {
        '@type': 'Person',
        name: 'Ben Balter',
        url: 'https://ben.balter.com',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

// Presentational icons for the three "how it works" steps. Locale-independent
// (paired with the steps by index), so they live here rather than in the
// string dictionary — they let the sequence read visually, without language.
const stepIcons = [
  // Upload
  '<path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/>',
  // Convert (transform / two-way arrows)
  '<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>',
  // Copy or save
  '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
];

// Markdown output for the "what gets converted" table. Universal syntax, so it
// stays literal here (untranslated) and pairs with t.conversionRows by index —
// the two arrays must stay the same length.
const conversionOutputs = [
  '# Heading',
  '**bold** *italic*',
  '1. item · - item',
  '| a | b |',
  '[text](url)',
  '`code`',
];
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  structuredData={structuredData}
  i18nPath="/"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-3xl pt-14 pb-2 text-center sm:pt-20">
    <p
      class="reveal font-mono text-[0.72rem] font-medium tracking-[0.22em] text-chartreuse-deep uppercase dark:text-chartreuse"
      style="animation-delay:.02s"
    >
      {t.eyebrow}
    </p>

    <h1
      class="reveal mt-5 text-balance text-5xl leading-[0.98] font-semibold tracking-tight text-navy sm:text-7xl dark:text-[#f1f2f7]"
      style="animation-delay:.08s"
    >
      <span class="font-display italic">Word</span>{' '}
      <span class="font-sans font-light text-navy-soft dark:text-mist">to</span>{
        ' '
      }
      <span class="font-mono font-medium tracking-tighter">Markdown</span>
    </h1>

    <p
      class="reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-navy-soft sm:text-xl dark:text-mist"
      style="animation-delay:.16s"
      set:html={t.tagline.replace(
        '.docx',
        '<code class="rounded bg-navy/5 px-1.5 py-0.5 font-mono text-[0.85em] text-navy dark:bg-white/10 dark:text-[#eef0f6]">.docx</code>'
      )}
    >
    </p>

    <!-- Visual .docx → .md flow: communicates the core function before reading. -->
    <div
      class="reveal mt-7 flex items-center justify-center gap-3 text-navy-soft dark:text-mist"
      style="animation-delay:.2s"
      role="img"
      aria-label={`${t.flowFromAlt} → ${t.flowToAlt}`}
    >
      <span
        class="inline-flex items-center gap-2 rounded-lg border border-rule-light bg-paper-card/70 px-3 py-2 dark:border-rule-dark dark:bg-ink-card/60"
        title={t.flowFromAlt}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
          <path d="M14 2v5h5" />
        </svg>
        <span class="font-mono text-xs font-medium tracking-tight">.docx</span>
      </span>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-chartreuse-deep dark:text-chartreuse"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>

      <span
        class="inline-flex items-center gap-2 rounded-lg border border-chartreuse/40 bg-chartreuse/10 px-3 py-2 text-chartreuse-deep dark:text-chartreuse"
        title={t.flowToAlt}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
          <path d="M14 2v5h5" />
          <path d="M8 13h2v4" />
          <path d="M14 13v4l2-2 2 2v-4" />
        </svg>
        <span class="font-mono text-xs font-medium tracking-tight">.md</span>
      </span>
    </div>
  </section>

  <!-- ── Converter ────────────────────────────────────────────────────── -->
  <section
    class="reveal mx-auto mt-10 max-w-2xl"
    style="animation-delay:.24s"
    aria-label={t.convertSectionAria}
  >
    <div id="input" data-error-generic={t.errorGeneric} data-dismiss={t.dismiss}>
      <label
        for="file"
        id="dropzone"
        class="dropzone group flex cursor-pointer flex-col items-center rounded-2xl border-2 border-dashed border-rule-light bg-paper-card/70 px-6 py-14 text-center shadow-[0_1px_2px_rgba(20,33,60,0.04)] backdrop-blur-sm dark:border-rule-dark dark:bg-ink-card/60"
      >
        <span
          class="dropzone-icon mb-5 inline-flex h-14 w-14 items-center justify-center rounded-full border border-chartreuse/40 bg-chartreuse/10 text-chartreuse-deep transition-transform dark:text-chartreuse"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 15V3" />
            <path d="m7 8 5-5 5 5" />
            <path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" />
          </svg>
        </span>
        <span
          class="font-display text-xl font-medium text-navy dark:text-[#f1f2f7]"
        >
          {t.dropzoneTitle}
        </span>
        <span class="mt-1.5 text-sm text-navy-soft dark:text-mist">
          {t.dropzoneBrowsePrefix}<span
            class="font-medium text-chartreuse-deep underline decoration-2 underline-offset-2 dark:text-chartreuse"
            >{t.dropzoneBrowseLink}</span
          >
        </span>
        <input type="file" id="file" accept=".docx" class="sr-only" />
      </label>

      <p
        class="mt-4 text-center font-mono text-[0.72rem] tracking-wide text-navy-soft/80 dark:text-mist/80"
      >
        {t.googleDocHint}
      </p>
    </div>

    <!-- Results (revealed after a successful conversion) -->
    <div id="results" class="hidden">
      <div
        class="mt-4 flex flex-col items-center justify-between gap-3 sm:flex-row"
      >
        <h2 class="font-display text-lg font-medium text-navy dark:text-[#f1f2f7]">
          {t.convertedLabel}{' '}<span
            id="filename"
            class="font-mono text-base text-chartreuse-deep dark:text-chartreuse"
          ></span>
        </h2>
        <div class="flex flex-wrap items-center gap-2">
          <button
            id="copy-button"
            type="button"
            data-clipboard-target="#output"
            class="inline-flex items-center gap-2 rounded-lg border border-navy/15 bg-paper-card px-3.5 py-2 text-sm font-medium text-navy transition-colors hover:border-chartreuse hover:bg-chartreuse/10 dark:border-white/15 dark:bg-ink-card dark:text-[#eef0f6] dark:hover:border-chartreuse"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            {t.copyButton}
          </button>
          <button
            id="download-button"
            type="button"
            class="inline-flex items-center gap-2 rounded-lg border border-navy/15 bg-paper-card px-3.5 py-2 text-sm font-medium text-navy transition-colors hover:border-chartreuse hover:bg-chartreuse/10 dark:border-white/15 dark:bg-ink-card dark:text-[#eef0f6] dark:hover:border-chartreuse"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <path d="M7 10l5 5 5-5" />
              <path d="M12 15V3" />
            </svg>
            {t.downloadButton}
          </button>
        </div>
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        <div
          class="overflow-hidden rounded-xl border border-rule-light bg-paper-card dark:border-rule-dark dark:bg-ink-card"
        >
          <div
            class="flex items-center gap-2 border-b border-rule-light px-4 py-2 dark:border-rule-dark"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-chartreuse"></span>
            <span
              class="font-mono text-xs font-medium tracking-wide text-navy-soft uppercase dark:text-mist"
              >{t.panelMarkdown}</span
            >
          </div>
          <pre
            class="max-h-[28rem] overflow-auto px-4 py-3 text-left"><code id="output" class="font-mono text-[0.82rem] leading-relaxed text-navy dark:text-[#e3e6ef]"></code></pre>
        </div>

        <div
          class="overflow-hidden rounded-xl border border-rule-light bg-paper-card dark:border-rule-dark dark:bg-ink-card"
        >
          <div
            class="flex items-center gap-2 border-b border-rule-light px-4 py-2 dark:border-rule-dark"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-navy-soft dark:bg-mist"></span>
            <span
              class="font-mono text-xs font-medium tracking-wide text-navy-soft uppercase dark:text-mist"
              >{t.panelPreview}</span
            >
          </div>
          <div
            id="rendered"
            class="prose prose-sm dark:prose-invert max-h-[28rem] max-w-none overflow-auto px-4 py-3 text-left"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Sponsor promo (Open & Async) ─────────────────────────────────── -->
  <a
    class="promo"
    href="https://open-and-async.com/?utm_source=word2md&utm_medium=referral"
  >
    <svg
      class="promo-graph"
      viewBox="0 0 560 150"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      role="presentation"
      aria-hidden="true"
    >
      <!-- chartreuse trunk -->
      <path
        d="M-10 88 C 110 88 165 78 265 80 S 455 98 580 84"
        stroke="#d0d820"
        stroke-width="2.2"></path>
      <circle cx="60" cy="85" r="5" fill="#d0d820"></circle>
      <circle cx="175" cy="79" r="5" fill="#d0d820"></circle>
      <circle
        cx="330"
        cy="84"
        r="7"
        fill="none"
        stroke="#d0d820"
        stroke-width="2"></circle>
      <circle cx="470" cy="91" r="5" fill="#d0d820"></circle>
      <!-- pink branch: diverges up -->
      <path
        d="M165 80 C 225 44 280 26 350 32 S 455 58 510 84"
        stroke="#e068a0"
        stroke-width="1.8"></path>
      <circle cx="350" cy="32" r="5" fill="#e068a0"></circle>
      <circle cx="440" cy="52" r="4" fill="#e068a0"></circle>
      <!-- coral branch: diverges down -->
      <path
        d="M265 80 C 325 118 365 136 455 134 S 600 122 630 134"
        stroke="#e89068"
        stroke-width="1.8"></path>
      <circle cx="455" cy="134" r="5" fill="#e89068"></circle>
    </svg>
    <img
      class="promo-cover"
      src="/open-and-async-cover.png"
      width="92"
      height="127"
      alt="Open and Async book cover"
    />
    <span class="promo-text">
      <span class="promo-label">Sponsored by me</span>
      <span class="promo-body">
        I built this free tool — and I wrote the book on working in the open:{' '}
        <strong>Open &amp; Async</strong>, the GitHub-tested playbook for remote
        and distributed teams.
      </span>
      <span class="promo-cta">Get notified &rarr;</span>
    </span>
  </a>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section class="mx-auto mt-20 max-w-3xl">
    <div class="grid gap-px overflow-hidden rounded-xl border border-rule-light bg-rule-light sm:grid-cols-3 dark:border-rule-dark dark:bg-rule-dark">
      {
        t.steps.map((step, i) => (
          <div class="bg-paper px-6 py-7 dark:bg-ink">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-chartreuse/40 bg-chartreuse/10 text-chartreuse-deep dark:text-chartreuse">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={stepIcons[i]}
                />
              </span>
              <span class="font-mono text-sm font-bold text-chartreuse-deep dark:text-chartreuse">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="mt-3 font-display text-lg font-medium text-navy dark:text-[#f1f2f7]">
              {step.t}
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-navy-soft dark:text-mist">
              {step.d}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── What gets converted ──────────────────────────────────────────── -->
  <section class="mx-auto mt-20 max-w-2xl">
    <h2
      class="text-center font-display text-2xl font-semibold tracking-tight text-navy sm:text-3xl dark:text-[#f1f2f7]"
    >
      {t.conversionHeading}
    </h2>
    <div
      class="mt-8 overflow-hidden rounded-xl border border-rule-light dark:border-rule-dark"
    >
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr
            class="border-b border-rule-light bg-paper-card/60 dark:border-rule-dark dark:bg-ink-card/50"
          >
            <th
              scope="col"
              class="px-5 py-3 font-display font-medium text-navy dark:text-[#f1f2f7]"
              >{t.conversionColElement}</th
            >
            <th
              scope="col"
              class="px-5 py-3 font-display font-medium text-navy dark:text-[#f1f2f7]"
              >{t.conversionColOutput}</th
            >
          </tr>
        </thead>
        <tbody class="divide-y divide-rule-light dark:divide-rule-dark">
          {
            t.conversionRows.map((row, i) => (
              <tr>
                <td class="px-5 py-3 text-navy-soft dark:text-mist">{row}</td>
                <td class="px-5 py-3">
                  <code class="font-mono text-[0.82rem] text-chartreuse-deep dark:text-chartreuse">
                    {conversionOutputs[i]}
                  </code>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── Command-line callout ─────────────────────────────────────────── -->
  <section class="mx-auto mt-16 max-w-2xl">
    <div
      class="flex flex-col items-start gap-4 rounded-xl border border-rule-light bg-paper-card/60 px-6 py-6 sm:flex-row sm:items-center sm:justify-between dark:border-rule-dark dark:bg-ink-card/50"
    >
      <div>
        <h2
          class="font-display text-lg font-medium text-navy dark:text-[#f1f2f7]"
        >
          {t.cliHeading}
        </h2>
        <p class="mt-1 text-sm leading-relaxed text-navy-soft dark:text-mist">
          {t.cliBody}
        </p>
      </div>
      <a
        href="https://github.com/benbalter/word-to-markdown-js#command-line"
        class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-navy/15 bg-paper-card px-3.5 py-2 text-sm font-medium text-navy transition-colors hover:border-chartreuse hover:bg-chartreuse/10 dark:border-white/15 dark:bg-ink-card dark:text-[#eef0f6] dark:hover:border-chartreuse"
      >
        {t.cliCta}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7" />
          <path d="M7 7h10v10" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="mx-auto mt-20 max-w-3xl">
    <h2
      class="text-center font-display text-2xl font-semibold tracking-tight text-navy sm:text-3xl dark:text-[#f1f2f7]"
    >
      {t.faqHeading}
    </h2>
    <div
      class="mt-8 divide-y divide-rule-light overflow-hidden rounded-xl border border-rule-light dark:divide-rule-dark dark:border-rule-dark"
    >
      {
        t.faqs.map((faq) => (
          <details class="group bg-paper-card/60 dark:bg-ink-card/50">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-base font-medium text-navy [&::-webkit-details-marker]:hidden dark:text-[#f1f2f7]">
              {faq.q}
              <svg
                class="h-4 w-4 shrink-0 text-chartreuse-deep transition-transform group-open:rotate-180 dark:text-chartreuse"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="px-5 pb-4 text-sm leading-relaxed text-navy-soft dark:text-mist">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import '../../src/index.ts';
</script>
