---
// Home page shell. Composes the page from focused section components (see
// ./home/*) and owns only what spans them: the schema.org structured data and
// the client script that wires up the converter. Each section resolves its own
// translations from the route's locale (Astro.currentLocale).
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import { asLocale, defaultLocale, localeMeta, useTranslations } from '../i18n';
import Hero from './home/Hero.astro';
import Converter from './home/Converter.astro';
import Promo from './home/Promo.astro';
import HowItWorks from './home/HowItWorks.astro';
import ConversionTable from './home/ConversionTable.astro';
import Callout from './home/Callout.astro';
import Faq from './home/Faq.astro';
import LanguageSuggestion from './home/LanguageSuggestion.astro';

const locale = asLocale(Astro.currentLocale);
const meta = localeMeta[locale];
const t = useTranslations(locale);

// Structured data (schema.org): the app, its npm package, the steps, and the
// FAQ. Google shows few of these as rich results any more; they're here for
// LLMs and other readers that parse schema.org.
// `inLanguage` and the human-readable copy follow the active locale. It spans
// multiple sections (FAQ copy lives in Faq.astro), so it stays here at the shell.
// URLs derive from `site` so the localized page describes its own URL and card.
const image = `/og/${locale}.png`;
const siteUrl = new URL('/', Astro.site).href;
const author = {
  '@type': 'Person',
  name: 'Ben Balter',
  url: 'https://ben.balter.com',
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Word to Markdown Converter',
      url: getAbsoluteLocaleUrl(locale, '/'),
      description: t.schemaDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: meta.htmlLang,
      image: new URL(image, Astro.site).href,
      isAccessibleForFree: true,
      featureList: t.schemaFeatureList,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author,
      isRelatedTo: {
        '@type': 'WebApplication',
        name: 'Markdown to Word Converter',
        url: 'https://md2word.app/',
      },
    },
    {
      '@type': 'WebSite',
      name: 'Word to Markdown',
      url: siteUrl,
      inLanguage: meta.htmlLang,
    },
    {
      // The same converter as a CLI and Node library, for agents and scripts.
      '@type': 'SoftwareSourceCode',
      name: 'word-to-markdown',
      description: t.cliBody,
      codeRepository: 'https://github.com/benbalter/word-to-markdown-js',
      programmingLanguage: 'TypeScript',
      runtimePlatform: 'Node.js',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      url: 'https://www.npmjs.com/package/word-to-markdown',
      author,
    },
    {
      '@type': 'HowTo',
      name: t.metaTitle,
      inLanguage: meta.htmlLang,
      step: t.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.t,
        text: s.d,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  image={image}
  structuredData={structuredData}
  i18nPath="/"
  markdownPath={locale === defaultLocale ? '/index.md' : undefined}
>
  <Hero />
  <Converter />
  {/* Everything below the converter is for visitors who haven't converted
       yet. Once a result shows, src/index.ts hides this block so the page is
       just the output; "Convert another file" brings it back. Without JS it
       never hides. */}
  <div id="pre-result">
    <HowItWorks />
    <Promo />
    <ConversionTable />
    <Callout
      heading={t.reverseHeading}
      body={t.reverseBody}
      cta={t.reverseCta}
      href="https://md2word.app/?utm_source=word2md&utm_medium=referral&utm_campaign=reverse"
    />
    <Callout
      heading={t.cliHeading}
      body={t.cliBody}
      cta={t.cliCta}
      href="/developers/"
    />
    <Faq />
  </div>
  {locale === defaultLocale && <LanguageSuggestion />}
</Layout>

<script>
  import '../../src/index.ts';
</script>
