{
  "name": "word-to-markdown",
  "version": "0.0.0",
  "description": "Convert Word documents to beautiful Markdown.",
  "type": "module",
  "engines": {
    "node": ">= 22.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@nuasite/checks": "^0.46.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/jest": "~30.0",
    "@types/node": "~26",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.62",
    "@typescript-eslint/parser": "^8.62",
    "astro": "^7.0.0",
    "eslint": "~8.57",
    "eslint-config-prettier": "~10.1",
    "eslint-plugin-jest": "~29.15",
    "jest": "~30.4",
    "jest-util": "~30.4",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.3.1",
    "ts-api-utils": "~2.5",
    "ts-jest": "~29.4",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "fix": "eslint --fix --ext .ts . && prettier --write .",
    "dev": "astro dev",
    "build": "npm run build:js && npm run build:site",
    "build:js": "tsc",
    "build:site": "astro check --minimumSeverity error && astro build",
    "preview": "astro preview",
    "lint": "eslint . --ext .ts --ext .mts && prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "all": "npm run fix && npm run test && npm run build && npm run check-builds",
    "check-builds": "./scripts/check-builds.sh"
  },
  "author": "Ben Balter <ben@balter.com>",
  "license": "ISC",
  "dependencies": {
    "@joplin/turndown": "^4.0.85",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "clipboard": "^2.0.11",
    "commander": "^15.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "markdownlint": "^0.41.0",
    "node-html-parser": "^7.0.1",
    "prettier": "~3.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tslib": "~2.8",
    "unified": "^11.0.5",
    "url": "^0.11.4"
  },
  "volta": {
    "node": "22.12.0"
  },
  "bin": {
    "w2m": "build/cli.js"
  },
  "main": "build/main.js"
}
