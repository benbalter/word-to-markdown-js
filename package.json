{
  "name": "word-to-markdown",
  "version": "0.3.0",
  "description": "Convert Word documents to beautiful Markdown.",
  "type": "module",
  "keywords": [
    "word",
    "docx",
    "markdown",
    "convert",
    "converter",
    "mammoth",
    "turndown",
    "cli"
  ],
  "homepage": "https://word2md.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/word-to-markdown-js.git"
  },
  "bugs": {
    "url": "https://github.com/benbalter/word-to-markdown-js/issues"
  },
  "engines": {
    "node": ">= 22.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@nuasite/checks": "^0.56.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "~30.0",
    "@types/node": "~26",
    "astro": "^7.2.2",
    "clipboard": "^2.0.11",
    "docx": "^9.7.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "~10.1",
    "eslint-plugin-jest": "~29.16",
    "globals": "^17.11.0",
    "jest": "~30.4",
    "jest-util": "~30.4",
    "playwright": "^1.62.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "ts-api-utils": "~2.5",
    "ts-jest": "~29.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unified": "^11.0.5"
  },
  "scripts": {
    "fix": "eslint --fix . && prettier --write .",
    "dev": "astro dev",
    "build": "npm run build:js && npm run build:site",
    "build:js": "tsc",
    "build:site": "astro check --minimumSeverity error && astro build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "all": "npm run fix && npm run test && npm run build && npm run check-builds",
    "check-builds": "./scripts/check-builds.sh",
    "gen:specs": "node scripts/gen-fixture-specs.mjs",
    "gen:fixtures": "npm run build:js && node scripts/build-fixtures.mjs",
    "gen:judge": "node scripts/judge-fixtures.mjs",
    "gen:i18n": "node scripts/translate-i18n.mjs",
    "prepack": "rm -rf build && npm run build:js"
  },
  "author": "Ben Balter <ben@balter.com>",
  "license": "ISC",
  "dependencies": {
    "@joplin/turndown": "^4.0.85",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@mixmark-io/domino": "^2.2.0",
    "commander": "^15.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "markdownlint": "^0.41.1",
    "node-html-parser": "^9.0.1",
    "prettier": "~3.9",
    "tslib": "~2.8"
  },
  "volta": {
    "node": "24.20.0"
  },
  "bin": {
    "w2m": "build/cli.js",
    "word-to-markdown": "build/cli.js"
  },
  "main": "build/main.js",
  "files": [
    "build/cli.js",
    "build/cli.js.map",
    "build/main.js",
    "build/main.js.map"
  ]
}
