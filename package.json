{
  "name": "word-to-markdown",
  "version": "0.5.1",
  "description": "Convert Word (.docx) documents to Markdown via CLI, Node.js, or browser",
  "type": "module",
  "keywords": [
    "word",
    "docx",
    "markdown",
    "convert",
    "converter",
    "mammoth",
    "turndown",
    "cli",
    "docx-to-markdown",
    "word-to-markdown",
    "microsoft-word",
    "md",
    "gfm"
  ],
  "homepage": "https://word2md.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/word-to-markdown-js.git"
  },
  "bugs": {
    "url": "https://github.com/benbalter/word-to-markdown-js/issues"
  },
  "engines": {
    "node": ">= 22.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "~30.5.2",
    "@mixmark-io/domino": "^2.2.0",
    "@nuasite/checks": "^0.56.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "~30.0",
    "@types/node": "~26",
    "astro": "^7.3.5",
    "docx": "^9.8.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "~10.1",
    "eslint-plugin-jest": "~29.16",
    "globals": "^17.12.0",
    "jest": "~30.5.2",
    "knip": "^6.39.0",
    "playwright": "^1.63.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "~29.4",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
    "wrangler": "^4.145.0"
  },
  "scripts": {
    "fix": "eslint --fix . && prettier --write .",
    "dev": "astro dev",
    "build": "npm run build:js && npm run build:site",
    "build:js": "tsc",
    "build:site": "astro check --minimumSeverity error && astro build",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "all": "npm run fix && npm run typecheck && npm run test && npm run build",
    "gen:specs": "node scripts/gen-fixture-specs.mjs",
    "gen:fixtures": "npm run build:js && node scripts/build-fixtures.mjs",
    "gen:judge": "node scripts/judge-fixtures.mjs",
    "gen:i18n": "node scripts/translate-i18n.mjs",
    "gen:og": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/gen-og.mjs",
    "prepack": "rm -rf build && npm run build:js",
    "knip": "knip"
  },
  "author": "Ben Balter <ben@balter.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@joplin/turndown": "^4.0.86",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "commander": "^15.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "markdownlint": "^0.41.1",
    "node-html-parser": "^9.0.4",
    "prettier": "~3.9"
  },
  "volta": {
    "node": "24.21.0"
  },
  "bin": {
    "w2m": "build/cli.js",
    "word-to-markdown": "build/cli.js"
  },
  "main": "build/main.js",
  "types": "build/main.d.ts",
  "exports": {
    ".": {
      "types": "./build/main.d.ts",
      "default": "./build/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/cli.js",
    "build/cli.js.map",
    "build/main.js",
    "build/main.js.map",
    "build/main.d.ts"
  ]
}
