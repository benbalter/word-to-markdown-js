{
  "compilerOptions": {
    // Node >= 22.13 (package.json engines) runs ES2022 natively.
    "target": "ES2022",
    "module": "node16",
    "lib": ["ES2022"],
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "build",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "strict": true,
    // Ship typings with the package. `@internal` exports (test hooks) are
    // left out of them.
    "declaration": true,
    "stripInternal": true,
    // src/ isn't published, so embed the sources in the maps.
    "sourceMap": true,
    "inlineSources": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // node-html-parser@9 ships a .d.ts with self-referential types that
    // TypeScript 6 rejects (TS2502); skip type-checking dependency
    // declarations, which is standard for library/app builds anyway.
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  // src/index.ts is the browser entry and src/converter.worker.ts (plus its
  // worker-only DOM shim) is its Web Worker — Astro/Vite bundles these for the
  // site, so tsc (which builds the Node CLI + library) skips them to avoid
  // emitting dead build/ output.
  "exclude": [
    "src/__tests__/**/*",
    "src/index.ts",
    "src/converter.worker.ts",
    "src/worker-dom-polyfill.ts"
  ]
}
