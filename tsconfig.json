{
  "compilerOptions": {
    "target": "ES6",
    "module": "node16",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "build",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "alwaysStrict": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  // src/index.ts is the browser entry — Astro/Vite bundles it for the site and
  // `astro check` type-checks it, so tsc (which builds the Node CLI + library)
  // skips it to avoid emitting a dead build/index.js.
  "exclude": ["src/__tests__/**/*", "src/index.ts"]
}
