{
  "compilerOptions": {
    // Node >= 22.13 (package.json engines) runs ES2022 natively.
    "target": "ES2022",
    "module": "node16",
    // DOM types for the domino document processHtml works on. Types only:
    // Node has no DOM globals at runtime, so reach the DOM through domino.
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "build",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Ship typings with the package. `@internal` exports (test hooks) are
    // left out of them.
    "declaration": true,
    "stripInternal": true,
    // src/ isn't published, so embed the sources in the maps.
    "sourceMap": true,
    "inlineSources": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Skip type-checking dependency declarations, which is standard for
    // library/app builds.
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  // src/index.ts is the browser entry, src/worker-client.ts drives its Web
  // Worker, and src/converter.worker.ts (plus its worker-only DOM shim) is the
  // worker itself — Astro/Vite bundles these for the site, so tsc (which builds
  // the Node CLI + library) skips them to avoid emitting dead build/ output.
  // tsconfig.browser.json type-checks them.
  "exclude": [
    "src/__tests__/**/*",
    "src/index.ts",
    "src/worker-client.ts",
    "src/converter.worker.ts",
    "src/worker-dom-polyfill.ts"
  ]
}
