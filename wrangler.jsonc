{
  // Cloudflare Workers (Static Assets) config. `wrangler deploy` builds a Worker
  // that serves the static Astro output in ./dist through the ASSETS binding.
  // `run_worker_first` runs worker/index.js (instead of serving an asset) for the
  // listed routes: "/" applies the Accept-Language redirect (or tags the page
  // with a language suggestion), and "/api/event" is
  // the anonymous conversion counter. Every other path is served directly from
  // assets. `name` matches the Cloudflare project created from the repo.
  "name": "word-to-markdown-js",
  "compatibility_date": "2026-06-01",
  // The site lives only at word2md.com. The *.workers.dev route was for
  // verification before the DNS cutover; left on, it serves a full mirror that
  // skips the zone's rules and Web Analytics. Set here because a dashboard
  // toggle is re-enabled by the next deploy. Preview URLs stay on so each PR's
  // Workers Builds preview runs the real Worker before production; disabling
  // workers.dev doesn't disable them.
  // https://developers.cloudflare.com/workers/configuration/routing/workers-dev/
  "workers_dev": false,
  "preview_urls": true,
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/event"],
    // Unknown paths get dist/404.html with a 404 status instead of a bare
    // Cloudflare error page.
    "not_found_handling": "404-page",
  },
  // Workers Analytics Engine dataset backing the conversion counter. The Worker
  // writes one fire-and-forget data point per conversion (no content, filename,
  // size, IP, or per-user id). Query totals via the SQL API:
  //   SELECT SUM(double1) FROM word2md_events WHERE blob1 = 'convert'
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "word2md_events" },
  ],
  // Worker Previews (`wrangler preview`, run by Workers Builds for every
  // non-main branch) need their own bindings. Previews write to a separate
  // dataset so beacons from preview pages never count in production totals.
  "previews": {
    "analytics_engine_datasets": [
      { "binding": "EVENTS", "dataset": "word2md_events_preview" },
    ],
  },
  // Real-time issue detection: groups uncaught exceptions, 5xx responses, and
  // console.error() calls into Issues in the dashboard. Set here because a
  // dashboard-only toggle is turned off by the next deploy.
  // https://developers.cloudflare.com/workers/observability/issues/
  "observability": {
    "issues": { "enabled": true },
  },
}
