# Response headers for Cloudflare Workers Static Assets (ignored elsewhere).
# The Content-Security-Policy itself ships as a <meta> tag on every page (see
# `security.csp` in astro.config.mjs); frame-ancestors can't be set that way,
# so it lives here. A second CSP header only adds restrictions, never loosens.
# HSTS is set at the Cloudflare zone, which overrides any value here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Astro emits content-hashed filenames under /_astro/, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The offline service worker (written at build by web/pwa/service-worker.ts).
# Browsers already revalidate it on update checks; no-cache makes sure every
# CDN and proxy does too, so a fix or the kill switch reaches users quickly.
/sw.js
  Cache-Control: no-cache

# The Markdown twins and llms.txt files are UTF-8 with non-ASCII text, but
# Static Assets labels them by extension alone, without a charset. RFC 7763
# requires one on text/markdown, and browsers read unlabeled text/plain as
# windows-1252, so curly quotes and accents come out garbled. The Worker sets
# the same type on a twin it serves for `Accept: text/markdown`.
/*.md
  Content-Type: text/markdown; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
